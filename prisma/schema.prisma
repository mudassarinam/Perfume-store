generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  email     String   @unique
  password  String   @db.VarChar(255)
  role      UserRole @default(ADMIN)

  @@map("users")
}

model Category {
  id          Int            @id @default(autoincrement())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  name        String         @unique
  description String?        @db.Text
  status      CategoryStatus @default(ACTIVE)
  products    Product[]

  @@index([status])
  @@map("categories")
}

model Brand {
  id          Int         @id @default(autoincrement())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  name        String      @unique
  description String?     @db.Text
  logo        String?     @db.VarChar(255)
  website     String?     @db.VarChar(255)
  status      BrandStatus @default(ACTIVE)
  products    Product[]

  @@index([status])
  @@map("brands")
}

model Product {
  id          Int            @id @default(autoincrement())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  name        String
  slug        String         @unique
  sku         String         @unique @db.VarChar(100)
  barcode     String?        @db.VarChar(100)
  gender      ProductGender
  price       Decimal        @db.Decimal(10, 2)
  costPrice   Decimal        @db.Decimal(10, 2)
  discount    Decimal        @default(0.00) @db.Decimal(10, 2)
  stock       Int            @default(0)
  volume      String?        @db.VarChar(50)
  image       String?        @db.VarChar(255)
  description String?        @db.Text
  featured    Boolean        @default(false)
  newArrival  Boolean        @default(false)
  topSeller   Boolean        @default(false)
  status      ProductStatus  @default(ACTIVE)
  categoryId  Int
  brandId     Int
  inventory   Inventory?
  orderItems  OrderItem[]
  images      ProductImage[]
  brand       Brand          @relation(fields: [brandId], references: [id])
  category    Category       @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([name])
  @@index([gender])
  @@index([featured])
  @@index([newArrival])
  @@index([topSeller])
  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  productId Int
  image     String   @db.VarChar(255)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Customer {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  email     String   @unique
  phone     String?  @db.VarChar(20)
  address   String?  @db.Text
  city      String?  @db.VarChar(100)
  country   String?  @db.VarChar(100)
  orders    Order[]

  @@index([name])
  @@index([phone])
  @@map("customers")
}

model Order {
  id            Int            @id @default(autoincrement())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  invoiceNo     String         @unique @db.VarChar(100)
  customerId    Int
  subtotal      Decimal        @db.Decimal(10, 2)
  discount      Decimal        @default(0.00) @db.Decimal(10, 2)
  tax           Decimal        @default(0.00) @db.Decimal(10, 2)
  grandTotal    Decimal        @db.Decimal(10, 2)
  status        OrderStatus    @default(PENDING)
  paymentStatus PaymentStatus  @default(PENDING)
  paymentMethod PaymentMethod?
  orderItems    OrderItem[]
  customer      Customer       @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orderId   Int
  productId Int
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  subtotal  Decimal  @db.Decimal(10, 2)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Inventory {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  productId    Int      @unique
  currentStock Int      @default(0)
  stockIn      Int      @default(0)
  stockOut     Int      @default(0)
  minimumStock Int      @default(5)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model Setting {
  id           Int          @id @default(autoincrement())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  storeName    String
  storeEmail   String
  storePhone   String       @db.VarChar(30)
  storeAddress String       @db.Text
  logo         String?      @db.VarChar(255)
  tax          Decimal      @default(0.00) @db.Decimal(10, 2)
  currency     CurrencyCode @default(USD)

  @@index([currency])
  @@map("settings")
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

enum ProductGender {
  MALE
  FEMALE
  BOTH
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum CurrencyCode {
  USD
  EUR
  GBP
  AED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum PaymentMethod {
  COD
  CARD
  JAZZCASH
  EASYPAISA
}
